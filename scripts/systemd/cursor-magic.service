[Unit]
Description=Dusky cursor-magic daemon (sprite aura + arrow control)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 %h/Projects/dusky-cursor-magic/cursor_magic.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
